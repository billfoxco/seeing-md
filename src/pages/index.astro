<script>
  const modal = document.querySelector<HTMLDialogElement>('#start-here');
  const triggers = document.querySelectorAll<HTMLButtonElement>('.start-trigger');
  const closeButton = modal?.querySelector<HTMLButtonElement>('.modal-close');
  const closeLinks = modal?.querySelectorAll<HTMLAnchorElement>('[data-close-modal]');

  triggers.forEach((trigger) => {
    trigger.addEventListener('click', () => modal?.showModal());
  });

  closeButton?.addEventListener('click', () => modal?.close());
  closeLinks?.forEach((link) => link.addEventListener('click', () => modal?.close()));

  modal?.addEventListener('click', (event) => {
    if (event.target === modal) modal.close();
  });
</script>
