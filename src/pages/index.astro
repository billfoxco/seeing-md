  @media (max-width: 760px) {
    body { font-size: 16px; }
    nav a { display: none; }
    .hero { min-height: auto; padding-top: 120px; }
    .hero-copy { padding-block: 60px 80px; }
    h1, .use h2 { font-size: 36px; }
