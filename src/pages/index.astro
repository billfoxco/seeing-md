---
/**
 * -----------------------------------------------------------------------------
 * SEEING.MD HOME PAGE
 * Route: /
 * Type: Page
 * Page version: 0.9.0 (lived practice; SEEING.md 0.9.0)
 * -----------------------------------------------------------------------------
 *
 * PURPOSE
 * Introduces SEEING.md as a portable perception specification for people and
 * AI. Begins with everyday definitions and an invitation to pause, then shows
 * what AI may amplify and gives visitors a direct way to use the file.
 *
 * AUDIENCE AND PRIMARY ACTION
 * - Audience: Leaders, teams, AI practitioners, designers, developers,
 *   consultants, coaches, and individual practitioners
 * - Primary action: Get SEEING.md, then download from the Begin section
 * - Supporting action: Open Start Here for guidance or a human conversation
 * - Leader action: Request a private 30-minute Seeing First session, alone or
 *   with a team
 *
 * EXPERIENCE / STRUCTURE
 * Definitions → Pause → AI amplification → Example → Lens → Scope → Begin → Origin.
 * The three operating behaviors sit within the AI section; usage instructions
 * are disclosed on demand. Seeing First follows the download as a quiet link.
 *
 * KEY RESPONSIBILITIES
 * - Serve the canonical specification from /SEEING.md.
 * - Give first-time visitors four plain-language ways to begin.
 * - Connect leaders to the Seeing First session through Cal.com.
 * - Connect the file to the deeper work at SEE DIFFERENT without obscuring the
 *   primary download action.
 *
 * DEPENDENCIES
 * - Layout: Standalone Astro page; no shared layout dependency
 * - Assets: Embedded open-frame SVG logo/favicon and public /SEEING.md
 * - Services: Google Fonts, Cal.com, and SEE DIFFERENT
 * - Hosting: Cloudflare Workers with Static Assets
 *
 * EDITING GUARDRAILS
 * - Preserve the Suede typography, spacing, black-and-white palette, and
 *   restrained use of #aa6600. Specifically:
 *   - Type scale: 12, 14, 16, 18, 20, 24, 30, 36, 48, 60px. No rem, no
 *     intermediate sizes. Headings 500 weight; 600 reserved for real emphasis.
 *   - Spacing scale: 20, 30, 40, 60, 80, 100px.
 *   - Color: black, white, and #aa6600 only, through the opacity ladder tokens
 *     (80 / 60 / 50 / 15 / 10). Do not introduce grays or tinted panels.
 *   - Width axis: "wdth" 110 (--wdth-expanded) for display type and numerals.
 *     Standard width everywhere else.
 *   - Rules and borders at 1px. Reading measure 640px (--measure); composition
 *     width 1280px (--content).
 *   - Motion: 250ms interface, 500ms larger movement, ease-out, ~30px travel.
 * - Keep the downloadable specification synchronized with the canonical
 *   SEEING.md file at the repository root.
 * - Keep the Seeing First pathway distinct from downloading SEEING.md.
 * - Keep Start Here choices outcome-based and free of technical language.
 * - Do not imply that SEEING.md resolves every category of AI safety risk.
 * - Keep the book as the primary source and the DESIGN.md influence in the
 *   closing origin section rather than the opening argument.
 * - Keep external links secure with rel="noopener".
 * -----------------------------------------------------------------------------
 */

const title = 'SEEING.md — The Perception Behind Intent';
const description =
  'A practice of noticing what we have already decided we are seeing. Begins before AI, with a portable file for examining what our instructions may amplify.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://seeing.md/" />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href="https://seeing.md/" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2032%2032%22%3E%3Cstyle%3Epath%7Bstroke%3A%2311110f%7D%40media%28prefers-color-scheme%3Adark%29%7Bpath%7Bstroke%3A%23fff%7D%7D%3C%2Fstyle%3E%3Cpath%20d%3D%22M20%204H4V28H28V10%22%20fill%3D%22none%22%20stroke-width%3D%223.2%22%2F%3E%3C%2Fsvg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:opsz,wdth,wght@6..144,75..125,100..1000&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <!-- Fathom - beautiful, simple website analytics -->
    <script src="https://scripts.withcabin.com/hello.js" async defer></script>
<!-- Fathom - beautiful, simple website analytics -->
<script src="https://cdn.usefathom.com/script.js" data-site="MWASYWBA" defer></script>
<!-- / Fathom -->
    <!-- / Fathom -->
  </head>

  <body>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="SEEING.md home">
        <svg class="wordmark-symbol" viewBox="0 0 32 32" width="32" height="32" fill="none" aria-hidden="true" focusable="false">
          <path d="M20 4H4V28H28V10" stroke="currentColor" stroke-width="3.2" />
        </svg>
        <span class="wordmark-text">SEEING<span class="wordmark-dot">.</span>md</span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="#why">Why</a>
        <a href="#seeing-first">Seeing First</a>
        <a href="#use">Use it</a>
        <button class="nav-start start-trigger" type="button">Start Here</button>
      </nav>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">The perception behind intent</p>
          <h1 id="hero-title">We don’t question what<br />we’ve already defined.</h1>
          <p class="hero-deck">
            The problem. The customer. The underperformer. The strategy.
          </p>
          <p class="hero-deck">
            Each can begin as an interpretation and become something we no longer question.
          </p>
          <div class="actions">
            <a class="button button-primary" href="#use">Get SEEING.md <span aria-hidden="true">→</span></a>
            <button class="text-link start-trigger" type="button">Start Here</button>
          </div>
        </div>

      </section>

      <section class="pause" id="pause" aria-labelledby="pause-title">
        <div class="pause-body">
          <p class="pause-invitation">Bring to mind the thing you or your team feels surest of.</p>
          <h2 id="pause-title">What is this?<br />What is it for?</h2>
          <p>The first answer may be the old definition repeating itself. Leave the question open a little longer.</p>
        </div>
      </section>

      <section class="statement" id="why" aria-labelledby="why-title">
        <div class="section-heading">
          <p class="section-number">What AI amplifies</p>
          <h2 id="why-title">AI scales what we see.<br />And what we don’t.</h2>
        </div>
        <div class="statement-body">
          <p>Before we hand a task to AI, we have already given it a way of seeing the situation. It can carry that definition into decisions, systems, and actions at scale.</p>
          <p>SEEING.md is a portable file for examining what shaped the intent. The practice begins before AI: noticing the first interpretation in ourselves.</p>
        </div>
        <div class="outcome-list">
          <article><span>01</span><h3>Separate</h3><p>Fact from interpretation.</p></article>
          <article><span>02</span><h3>Surface</h3><p>What has already been assumed.</p></article>
          <article><span>03</span><h3>Ask</h3><p>The question the framing concealed.</p></article>
        </div>
      </section>

      <section class="example-section" aria-labelledby="example-title">
        <div class="example-grid">
          <div>
            <h2 id="example-title" class="example-label">The definition</h2>
            <p class="example-text">“They’re an underperformer.”</p>
          </div>
          <div>
            <h3 class="example-label">What might the label conceal?</h3>
            <p class="example-text">What happened—and what have we decided it says about the person?</p>
          </div>
        </div>
        <p class="example-question">Before asking AI to write a performance plan, distinguish observed results from the meaning assigned to them. The concern may be justified. The label still deserves a second look.</p>
      </section>

      <section class="lens" aria-labelledby="lens-title">
        <h2 id="lens-title">A <span>lens.</span> Not the lens.</h2>
        <p>Any insight about perception that cannot question itself eventually becomes another lens.</p>
        <p class="lens-note">An alternative framing is something to examine, not something to adopt. Question this file too. Living the practice does not put anyone beyond it.</p>
      </section>

      <section class="scope" aria-labelledby="scope-title">
        <h2 id="scope-title">Upstream, not all-encompassing.</h2>
        <div class="scope-grid">
          <div>
            <h3>It addresses</h3>
            <p>Human assumptions entering purpose, data, measures, prompts, evaluation, and use.</p>
          </div>
          <div>
            <h3>It does not prevent</h3>
            <p>Autonomous behavior, malicious use, cyberattacks, deception, or loss of control.</p>
          </div>
        </div>
      </section>

      <section class="use" id="use" aria-labelledby="use-title">
        <p class="section-number">Begin</p>
        <h2 id="use-title">What have I already<br />decided this is?</h2>
        <p class="use-intro">Begin with an ordinary moment: an email, a conversation, a result. Let the question interrupt your first interpretation.</p>
        <div class="actions">
          <a class="button button-primary" href="/SEEING.md" download onclick="window.fathom?.trackEvent('SEEING.md download');">Download SEEING.md <span aria-hidden="true">→</span></a>
        </div>
        <p class="use-note">Version 0.9.0 · 3 October 2026. For work with AI, attach the file to a conversation, brief, or project and ask it to read it before responding.</p>
        <details class="usage-details">
          <summary>How to use it</summary>
          <div class="instruction">
            <h3>In a conversation</h3>
            <p>Attach the file, then ask:</p>
            <blockquote>Read SEEING.md before responding. Apply it when the work involves people, judgment, strategy, interpretation, or a consequential decision. Question what may be shaping the request, including the assumptions this file brings to the inquiry.</blockquote>
          </div>
          <div class="instruction">
            <h3>For repeated project use</h3>
            <p>Add the file to your project and include this in its instructions:</p>
            <blockquote>Before work involving judgment, people, strategy, interpretation, or consequential decisions, read SEEING.md. Use it to examine what may be shaping the request, including the assumptions in SEEING.md, before acting. Apply it proportionally; do not slow straightforward technical work unnecessarily.</blockquote>
          </div>
          <p class="use-note">The file may not be read automatically. AI can help surface assumptions; people examine them and remain responsible for what is acted upon.</p>
        </details>
        <div class="orientation">
          <p class="orientation-steps"><span>Notice <i aria-hidden="true">→</i></span> <span>Question <i aria-hidden="true">→</i></span> <span>See Again <i aria-hidden="true">→</i></span> <span>Act</span></p>
          <p>The next action may be simpler. It may be something you no longer need to say or do.</p>
        </div>
        <div class="seeing-first" id="seeing-first">
          <p>Want to experience this with a real decision?</p>
          <a class="text-link" href="https://cal.com/billfox/seeing-first" rel="noopener">Seeing First <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section class="origin" aria-labelledby="origin-title">
        <p class="section-number">Origin</p>
        <div>
          <h2 id="origin-title">The file is portable. The practice is lived.</h2>
          <p>SEEING.md emerged from <em>The Perception Miracle</em> and more than 500 explorations into how the past enters what we see now.</p>
          <p>Its form was influenced by Brian Gardner’s DESIGN.md. SEEING.md asks the question one level further upstream: What shaped the intent?</p>
          <div class="actions">
            <a class="text-link" href="https://seedifferent.xyz/perception-miracle/" rel="noopener">The Perception Miracle <span aria-hidden="true">→</span></a>
            <a class="text-link" href="https://seedifferent.xyz" rel="noopener">SEE DIFFERENT <span aria-hidden="true">→</span></a>
            <a class="text-link" href="https://billfox.co/" rel="author noopener">Bill Fox <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </section>
    </main>

    <dialog class="start-modal" id="start-here" aria-labelledby="start-title">
      <div class="modal-panel">
        <button class="modal-close" type="button" aria-label="Close Start Here">Close</button>
        <p class="section-number">Start here</p>
        <h2 id="start-title">What would be most useful now?</h2>
        <div class="start-options">
          <a href="/SEEING.md" download onclick="window.fathom?.trackEvent('SEEING.md download');">
            <span class="option-number">01</span>
            <span>
              <strong>Use SEEING.md</strong>
              <small>Download the file and attach it to an AI conversation.</small>
            </span>
            <i aria-hidden="true">↓</i>
          </a>
          <a href="#pause" data-close-modal>
            <span class="option-number">02</span>
            <span>
              <strong>Leave a question open</strong>
              <small>Begin with something you feel sure you understand.</small>
            </span>
            <i aria-hidden="true">→</i>
          </a>
          <a href="https://cal.com/billfox/seeing-first" rel="noopener">
            <span class="option-number">03</span>
            <span>
              <strong>Bring a real decision</strong>
              <small>Experience Seeing First in 30 minutes.</small>
            </span>
            <i aria-hidden="true">↗</i>
          </a>
          <a href="mailto:hello@seeing.md?subject=Help%20using%20SEEING.md&amp;body=What%20are%20you%20working%20on%2C%20and%20where%20would%20you%20like%20help%20using%20SEEING.md%3F%0A%0A">
            <span class="option-number">04</span>
            <span>
              <strong>Work with me</strong>
              <small>Get help using SEEING.md in your project, leadership work, or AI workflow.</small>
            </span>
            <i aria-hidden="true">→</i>
          </a>
        </div>
      </div>
    </dialog>

    <footer>
      <a class="wordmark" href="/" aria-label="SEEING.md home">
        <svg class="wordmark-symbol" viewBox="0 0 32 32" width="32" height="32" fill="none" aria-hidden="true" focusable="false">
          <path d="M20 4H4V28H28V10" stroke="currentColor" stroke-width="3.2" />
        </svg>
        <span class="wordmark-text">SEEING<span class="wordmark-dot">.</span>md</span>
      </a>
      <p>Seeing is the first decision.</p>
      <a class="footer-contact" href="mailto:hello@seeing.md">hello@seeing.md</a>
      <p class="footer-thread">
        One question. <a href="https://billfox.co/">A person</a> ·
        <a href="https://seedifferent.xyz">a practice</a> ·
        <span aria-current="page">a system</span>.
      </p>
      <p class="footer-license">
        © 2026 <a href="https://billfox.co/" rel="author">Bill Fox</a>. The SEEING.md specification is licensed under
        <a href="https://creativecommons.org/licenses/by/4.0/" rel="license" aria-label="Creative Commons Attribution 4.0 International license">CC BY 4.0</a>.
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --ink: #000000;
    --paper: #ffffff;
    --amber: #aa6600;
    --white-80: rgba(255,255,255,.8);
    --white-60: rgba(255,255,255,.6);
    --white-50: rgba(255,255,255,.5);
    --white-15: rgba(255,255,255,.15);
    --white-10: rgba(255,255,255,.1);
    --black-80: rgba(0,0,0,.8);
    --black-60: rgba(0,0,0,.6);
    --black-50: rgba(0,0,0,.5);
    --black-15: rgba(0,0,0,.15);
    --black-10: rgba(0,0,0,.1);
    --line-dark: var(--white-15);
    --line-light: var(--black-15);
    --wdth-expanded: "wdth" 110;
    --content: 1280px;
    --measure: 640px;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--paper); color: var(--ink); font-family: "Google Sans Flex", ui-sans-serif, system-ui, sans-serif; font-size: 18px; line-height: 1.6; text-rendering: optimizeLegibility; -webkit-font-smoothing: antialiased; }
  a { color: inherit; text-decoration: none; }
  button { font: inherit; }
  h1, h2, h3, p { text-wrap: pretty; }
  h1, h2, h3 { font-weight: 500; }
  .site-header, main > section, footer { padding-inline: max(20px, calc((100% - var(--content)) / 2)); }
  .site-header { position: absolute; z-index: 2; top: 0; left: 0; display: flex; width: 100%; align-items: center; justify-content: space-between; padding-block: 30px; color: var(--paper); }
  .wordmark { display: inline-flex; align-items: center; gap: .55em; font-size: 24px; line-height: 1; letter-spacing: -.025em; white-space: nowrap; }
  .wordmark-symbol { display: block; width: 1.3em; height: 1.3em; flex-shrink: 0; }
  .wordmark-dot { color: inherit; }
  nav { display: flex; align-items: center; gap: 30px; }
  nav a, .nav-start { font-size: 14px; color: var(--white-60); }
  .nav-start { padding: 0; border: 0; background: transparent; cursor: pointer; }
  nav a:hover, .nav-start:hover { color: var(--paper); }
  .hero { display: grid; min-height: 100svh; grid-template-rows: 1fr; padding-top: 140px; padding-bottom: 40px; background: var(--ink); color: var(--paper); }
  .hero-copy { max-width: 960px; align-self: center; padding-block: 60px 100px; animation: rise 500ms ease-out both; }
  @keyframes rise { from { opacity: 0; transform: translateY(30px); } }
  .eyebrow, .section-number { margin: 0 0 30px; color: var(--black-60); font-size: 14px; font-weight: 500; letter-spacing: .05em; text-transform: uppercase; }
  .hero .eyebrow { color: var(--white-60); }
  h1 { max-width: 920px; margin: 0; font-size: 60px; font-variation-settings: var(--wdth-expanded); line-height: 1.05; }
  .hero-deck { max-width: var(--measure); margin: 40px 0 0; color: var(--white-60); font-size: 20px; line-height: 1.55; }
  .actions { display: flex; align-items: center; gap: 30px; margin-top: 40px; flex-wrap: wrap; }
  .button { display: inline-flex; min-height: 60px; align-items: center; justify-content: center; gap: 20px; padding: 20px 30px; border: 1px solid var(--ink); background: var(--ink); color: var(--paper); font-size: 12px; font-weight: 500; letter-spacing: .05em; text-transform: uppercase; cursor: pointer; transition: background 250ms ease-out, color 250ms ease-out; }
  .hero .button { border-color: var(--paper); background: var(--paper); color: var(--ink); }
  .button:hover { background: var(--paper); color: var(--ink); }
  .hero .button:hover { background: var(--ink); color: var(--paper); }
  .text-link { display: inline-block; padding: 0; border: 0; background: transparent; color: inherit; cursor: pointer; text-decoration: underline; text-decoration-color: var(--black-50); text-underline-offset: 5px; font-size: 14px; font-weight: 500; transition: color 250ms ease-out; }
  .text-link span { margin-left: 10px; }
  .text-link:hover { color: var(--amber); }
  .hero .text-link { color: var(--white-60); text-decoration-color: var(--white-50); }
  .hero .text-link:hover { color: var(--paper); }
  main > section:not(.hero) { padding-block: 100px; }
  .pause-body { max-width: 900px; margin-inline: auto; }
  .pause h2 { margin: 0; font-size: 60px; line-height: 1.2; }
  .pause p { max-width: var(--measure); margin: 30px 0 0; color: var(--black-60); font-size: 16px; }
  .pause .pause-invitation { margin: 0 0 60px; }
  .pause h2 + p { margin-top: 60px; }
  .section-heading { display: grid; grid-template-columns: minmax(170px,.35fr) 1.65fr; gap: 60px; }
  .statement h2 { margin: 0; font-size: 48px; line-height: 1.1; }
  .statement-body { max-width: var(--measure); margin: 40px 0 0 calc((100% - 60px) * .175 + 60px); }
  .statement-body p { margin: 0 0 30px; color: var(--black-60); }
  .outcome-list { display: grid; grid-template-columns: repeat(3,1fr); gap: 60px; margin-top: 80px; }
  .outcome-list article { display: grid; grid-template-columns: auto 1fr; column-gap: 20px; align-content: start; align-items: baseline; }
  .outcome-list span { color: var(--black-50); font-size: 12px; font-variation-settings: var(--wdth-expanded); }
  .outcome-list h3 { margin: 0; font-size: 20px; }
  .outcome-list p { grid-column: 2; margin: 20px 0 0; color: var(--black-60); font-size: 16px; }
  main > .example-section { padding-top: 60px; }
  .example-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 80px; padding-top: 60px; border-top: 1px solid var(--line-light); }
  .example-label { margin: 0 0 30px; color: var(--black-60); font-size: 14px; }
  .example-text { margin: 0; max-width: 560px; font-size: 30px; line-height: 1.3; }
  .example-question { max-width: 900px; margin: 60px 0 0; font-size: 24px; line-height: 1.4; }
  main > .lens { padding-block: 60px 100px; }
  .lens h2 { margin: 0; font-size: 30px; line-height: 1.2; }
  .lens h2 span { color: var(--amber); }
  .lens p { max-width: var(--measure); margin: 30px 0 0; font-size: 20px; }
  .lens .lens-note { font-size: 16px; color: var(--black-60); }
  main > .scope { padding-block: 60px; background: var(--ink); color: var(--paper); }
  .scope h2 { margin: 0; font-size: 30px; line-height: 1.2; }
  .scope-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 80px; margin-top: 40px; padding-top: 40px; border-top: 1px solid var(--line-dark); }
  .scope-grid h3 { margin: 0; font-size: 16px; }
  .scope-grid p { max-width: 560px; margin: 20px 0 0; color: var(--white-60); font-size: 16px; }
  .use h2 { margin: 0; font-size: 60px; font-variation-settings: var(--wdth-expanded); line-height: 1.05; }
  .use-intro { max-width: var(--measure); margin: 40px 0 0; font-size: 20px; }
  .use-note { max-width: var(--measure); margin: 30px 0 0; font-size: 14px; color: var(--black-60); }
  .usage-details { max-width: var(--measure); margin-top: 30px; }
  .usage-details summary { width: fit-content; cursor: pointer; font-size: 14px; text-decoration: underline; text-underline-offset: 5px; }
  .instruction { margin-top: 40px; }
  .instruction h3 { margin: 0; font-size: 16px; }
  .instruction p, .instruction blockquote { margin: 20px 0 0; font-size: 16px; }
  .instruction blockquote { padding-left: 20px; border-left: 1px solid var(--line-light); color: var(--black-60); }
  .orientation { margin-top: 80px; }
  .orientation p { margin: 20px 0 0; color: var(--black-60); font-size: 14px; }
  .orientation .orientation-steps { display: flex; flex-wrap: wrap; gap: 20px; margin: 0; color: var(--ink); font-size: 16px; font-weight: 500; letter-spacing: .05em; text-transform: uppercase; }
  .orientation-steps span { white-space: nowrap; }
  .orientation-steps i { margin-left: 20px; font-style: normal; color: var(--black-50); }
  .seeing-first { margin-top: 60px; }
  .seeing-first p { margin: 0 0 20px; font-size: 16px; color: var(--black-60); }
  main > .origin { display: grid; grid-template-columns: minmax(170px,.35fr) 1.65fr; gap: 60px; padding-block: 80px; border-top: 1px solid var(--line-light); }
  .origin h2 { max-width: 760px; margin: 0; font-size: 36px; line-height: 1.2; }
  .origin > div > p { max-width: var(--measure); margin: 30px 0 0; color: var(--black-60); font-size: 16px; }
  .start-modal { width: min(720px, calc(100% - 40px)); max-height: calc(100svh - 40px); padding: 0; border: 0; background: var(--paper); color: var(--ink); }
  .start-modal::backdrop { background: var(--black-80); }
  .modal-panel { position: relative; padding: 60px; }
