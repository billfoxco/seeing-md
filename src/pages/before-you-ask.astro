---
import { readFileSync } from 'node:fs';

// Read activation language and release details from the canonical specification.
const specification = readFileSync(new URL('../../SEEING.md', import.meta.url), 'utf8');
const release = specification.match(/\*\*Version (.+?)\*\*/)?.[1];
const conversationPrompt = specification.match(/Then tell the AI:\n\n> (.+)/)?.[1];
const projectPrompt = specification.match(/If you use project-level instructions, add:\n\n> (.+)/)?.[1];
if (!release || !conversationPrompt || !projectPrompt) throw new Error('Check SEEING.md activation language before publishing the guide.');
const title = 'Before You Ask — SEEING.md';
const description = 'A short visual introduction to SEEING.md: what shapes a request, what AI can amplify, and how to begin with a real question.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://seeing.md/before-you-ask/" />
    <meta property="og:image" content="https://seeing.md/images/before-you-ask/ai-begins-before-the-system.webp" />
    <meta property="og:image:alt" content="AI begins before the system. What shaped the intent?" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href="https://seeing.md/before-you-ask/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:wdth,wght@75..125,100..1000&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <script src="https://scripts.withcabin.com/hello.js" async defer></script>
    <script src="https://cdn.usefathom.com/script.js" data-site="MWASYWBA" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#narrative">Skip to the narrative</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="wordmark" href="/" aria-label="SEEING.md home">
          <svg viewBox="0 0 32 32" width="20" height="20" fill="none" aria-hidden="true"><path d="M20 4H4V28H28V10" stroke="currentColor" stroke-width="3.2" /></svg>
          <span>SEEING.md</span>
        </a>
        <button id="presentation-toggle" class="quiet-button" aria-pressed="false" hidden>Presentation view</button>
      </div>
    </header>

    <main id="narrative" tabindex="-1">
      <section class="chapter opening" id="before-you-ask" aria-labelledby="opening-title" data-chapter>
        <div class="wrap chapter-grid">
          <div class="copy">
            <p class="eyebrow">01 / Before you ask</p>
            <h1 id="opening-title" tabindex="-1">Something has <br />already happened.</h1>
            <p>Before we ask what to do, we’ve often already decided what we’re looking at.</p>
            <p>The difficult person. The failing project. The change everyone needs to accept.</p>
            <p class="muted">An interpretation can arrive so quickly that it feels like the situation itself.</p>
            <a class="text-link" href="#amplification">Begin here <span aria-hidden="true">↓</span></a>
          </div>
          <figure>
            <img src="/images/before-you-ask/decided-before-i-looked.webp" width="3840" height="2160" fetchpriority="high" alt="One viewpoint projects onto work, the past, and the news. The image asks whether the problem begins in what we see or how we see it." />
            <figcaption>What have I already decided this is?</figcaption>
          </figure>
        </div>
      </section>

      <section class="chapter" id="amplification" aria-labelledby="amplification-title" data-chapter>
        <div class="wrap chapter-grid">
          <div class="copy">
            <p class="eyebrow">02 / What gets carried forward</p>
            <h2 id="amplification-title" tabindex="-1">AI scales what we see. <br /><span class="muted">And what we don’t.</span></h2>
            <p>Our instructions carry a picture of the situation: what matters, what the problem is, and what success should look like.</p>
            <p>AI can help us act on that picture with greater speed and reach. A more rigorous answer can still begin with an unexamined question.</p>
          </div>
          <figure>
            <img src="/images/before-you-ask/ai-begins-before-the-system.webp" width="3840" height="2160" loading="lazy" alt="AI begins before the system. What shaped the intent? Seeing leads to intent, system, and scale." />
            <figcaption>What will this instruction amplify?</figcaption>
          </figure>
        </div>
      </section>

      <section class="chapter" id="the-file" aria-labelledby="file-title" data-chapter>
        <div class="wrap chapter-grid">
          <div class="copy">
            <p class="eyebrow">03 / A pause before action</p>
            <h2 id="file-title" tabindex="-1">Make the first <br />interpretation visible.</h2>
            <p>SEEING.md is a portable perception specification for people and AI. It invites a closer look at what shaped the intent.</p>
            <p>You can begin without AI. Bring to mind something you feel sure you understand. Ask what you’ve already decided it means.</p>
            <p class="muted">Leave room for the first answer to be incomplete. Question what this file asks you to see, too.</p>
          </div>
          <figure>
            <img src="/images/before-you-ask/the-space-before-seeing-again.webp" width="3840" height="2160" loading="lazy" alt="Notice and question. A space marked not knowing. Then see again and act." />
            <figcaption>Notice → Question → See again → Act. An orientation, not a formula.</figcaption>
          </figure>
        </div>
      </section>

      <section class="chapter example" id="an-example" aria-labelledby="example-title" data-chapter>
        <div class="wrap">
          <p class="eyebrow">04 / An illustrative example</p>
          <h2 id="example-title" tabindex="-1">Before making it <br />more persuasive.</h2>
          <div class="example-grid">
            <div>
              <h3>The request</h3>
              <blockquote>Help me persuade my team to accept this change.</blockquote>
              <p class="muted">The request sets acceptance as the outcome. It doesn’t yet tell us what the team has said.</p>
            </div>
            <div>
              <h3>A question SEEING.md might raise</h3>
              <blockquote>What concerns has the team actually expressed, and could any of them change the plan?</blockquote>
              <p class="muted">The change may still be right. The next step might be a clearer explanation, a conversation, or a revision.</p>
            </div>
          </div>
          <p class="closing-question">Bring to mind a request of your own. What has it already decided?</p>
        </div>
      </section>

      <section class="chapter try" id="try-it" aria-labelledby="try-title" data-chapter>
        <div class="wrap">
          <p class="eyebrow">05 / Begin with your own work</p>
          <h2 id="try-title" tabindex="-1">One file. <br />One real question.</h2>
          <div class="try-grid">
            <div>
              <ol class="steps">
                <li><strong>Download SEEING.md.</strong><span>It’s a plain text file. No technical experience is needed.</span></li>
                <li><strong>Attach it.</strong><span>Add it to an AI conversation or your project’s reference files.</span></li>
                <li><strong>Ask the AI to read it.</strong><span>Copy the instruction here, then bring a real decision, brief, or question. Adding a file alone may not activate it.</span></li>
              </ol>
              <a class="button" href="/SEEING.md" download>Download SEEING.md</a>
              <p class="small muted">Version {release} · Free under CC BY 4.0</p>
            </div>
            <div class="prompt-column">
              <h3>In a conversation</h3>
              <blockquote id="conversation-prompt">{conversationPrompt}</blockquote>
              <button class="quiet-button copy-button" data-copy="conversation-prompt" hidden>Copy instruction</button>
              <details>
                <summary>For repeated project use</summary>
                <blockquote id="project-prompt">{projectPrompt}</blockquote>
                <button class="quiet-button copy-button" data-copy="project-prompt" hidden>Copy project instruction</button>
              </details>
              <p class="small muted">Look for a distinction between facts and interpretation, or one useful question when something consequential is missing. Examine what the AI suggests. You provide context and decide what to act on. Routine work should remain routine.</p>
            </div>
          </div>
          <p id="copy-status" class="small" role="status" aria-live="polite"></p>
        </div>
      </section>

      <section class="chapter continue" id="continue" aria-labelledby="continue-title" data-chapter>
        <div class="wrap">
          <p class="eyebrow">06 / Keep looking</p>
          <h2 id="continue-title" tabindex="-1">The practice begins <br />before the file.</h2>
          <p class="measure">SEEING.md grew from <em>The Perception Miracle</em> and more than 500 explorations. The book offers room to stay with the inquiry through images, ordinary situations, and questions.</p>
          <div class="destinations">
            <a href="https://book.seedifferent.xyz/" rel="noopener"><span>The Perception Miracle</span><span class="muted">Explore the book <span aria-hidden="true">↗</span></span></a>
            <a href="https://seedifferent.xyz/" rel="noopener"><span>SEE DIFFERENT</span><span class="muted">Discover the wider work <span aria-hidden="true">↗</span></span></a>
          </div>
          <p class="small muted measure">The file invites examination, including of its own assumptions. It cannot guarantee clear seeing, eliminate bias, or resolve every category of AI risk.</p>
          <a class="text-link" href="/">Return to SEEING.md <span aria-hidden="true">→</span></a>
        </div>
      </section>
    </main>

    <nav id="presentation-controls" class="presentation-controls" aria-label="Presentation" hidden>
      <button id="previous-chapter" class="quiet-button" aria-label="Previous section">← Previous</button>
      <span id="chapter-counter" role="status" aria-live="polite" aria-atomic="true">1 / 6</span>
      <button id="next-chapter" class="quiet-button" aria-label="Next section">Next →</button>
    </nav>
    <footer><div class="wrap footer-inner"><span>© 2026 <a href="https://billfox.co/" rel="author noopener">Bill Fox</a></span><span>Images from <em>The Perception Miracle</em></span><a href="mailto:hello@seeing.md">hello@seeing.md</a></div></footer>
    <script>import '../scripts/before-you-ask';</script>
  </body>
</html>

<style is:global>
  :root { --ink:#000; --paper:#fff; --amber:#aa6600; --w80:rgba(255,255,255,.8); --w60:rgba(255,255,255,.6); --w15:rgba(255,255,255,.15); --gutter:clamp(20px,4vw,80px); --content:1280px; --s30:clamp(20px,3vw,30px); --s40:clamp(30px,4vw,40px); --s60:clamp(40px,6vw,60px); --s80:clamp(60px,8vw,80px); --s100:clamp(70px,10vw,100px); }
  * { box-sizing:border-box; }
  [hidden] { display:none !important; }
  html { scroll-behavior:smooth; scroll-padding-top:100px; }
  body { margin:0; background:var(--ink); color:var(--paper); font-family:"Google Sans Flex",ui-sans-serif,system-ui,sans-serif; font-size:18px; line-height:1.75; letter-spacing:.01em; -webkit-font-smoothing:antialiased; }
  h1,h2,h3,p,figure,blockquote { margin:0; }
  h1,h2,h3 { font-weight:500; text-wrap:balance; letter-spacing:0; }
  h1,h2 { font-size:clamp(36px,3.8vw,48px); line-height:1; }
  h1 { font-size:clamp(40px,4.2vw,60px); }
  h3 { font-size:18px; line-height:1.5; }
  p { text-wrap:pretty; }
  a { color:inherit; text-underline-offset:3px; text-decoration-thickness:1px; }
  button { font:inherit; cursor:pointer; }
  a,button { -webkit-tap-highlight-color:transparent; }
  :focus-visible { outline:2px solid var(--paper); outline-offset:5px; }
  h1:focus,h2:focus,main:focus { outline:none; }
  .wrap { width:100%; max-width:var(--content); margin-inline:auto; }
  .site-header,.chapter,footer { padding-inline:var(--gutter); }
  .site-header { border-bottom:1px solid var(--w15); }
  .header-inner { display:flex; align-items:center; justify-content:space-between; min-height:80px; gap:20px; }
  .wordmark { display:inline-flex; align-items:center; gap:12px; font-size:16px; line-height:1; font-weight:500; text-decoration:none; white-space:nowrap; }
  .wordmark svg { flex:none; }
  .quiet-button { color:var(--paper); background:transparent; border:1px solid var(--w15); padding:14px 20px; min-height:44px; font-size:12px; line-height:1.25; font-weight:500; letter-spacing:.05em; text-transform:uppercase; transition:border-color 250ms ease-out,background 250ms ease-out; }
  .quiet-button:hover { border-color:var(--w60); background:rgba(255,255,255,.05); }
  .quiet-button:disabled { opacity:.35; cursor:default; }
  .skip-link { position:fixed; top:12px; left:20px; z-index:10; transform:translateY(-200%); background:var(--paper); color:var(--ink); padding:10px 20px; }
  .skip-link:focus { transform:none; }
  .chapter { padding-block:var(--s100); border-bottom:1px solid var(--w15); scroll-margin-top:0; }
  .chapter-grid { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:var(--s80); align-items:center; }
  .copy { max-width:580px; }
  .eyebrow { font-size:12px; line-height:1.5; font-weight:500; letter-spacing:.05em; text-transform:uppercase; color:var(--w60); margin-bottom:var(--s30); }
  .copy > p:not(.eyebrow),.measure { margin-top:var(--s30); color:var(--w80); }
  .muted { color:var(--w60) !important; }
  figure { min-width:0; }
  figure img { display:block; width:100%; height:auto; border:1px solid var(--w15); }
  figcaption { margin-top:20px; color:var(--w60); font-size:14px; line-height:1.5; }
  .text-link { display:inline-block; margin-top:var(--s40); font-size:16px; }
  .text-link span { margin-left:10px; }
  .text-link:hover,footer a:hover { color:var(--w60); }
  .example-grid,.try-grid { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:var(--s80); margin-top:var(--s60); }
  .example blockquote { font-size:clamp(24px,2.4vw,30px); line-height:1.5; margin-top:20px; padding-left:20px; border-left:1px solid var(--amber); }
  .example-grid p { margin-top:var(--s30); }
  .closing-question { max-width:740px; margin-top:var(--s60); font-size:24px; line-height:1.5; }
  .steps { list-style:none; counter-reset:steps; margin:0; padding:0; }
  .steps li { counter-increment:steps; position:relative; padding-left:40px; margin-bottom:var(--s30); }
  .steps li::before { content:counter(steps,decimal-leading-zero); position:absolute; left:0; top:3px; font-size:12px; color:var(--w60); }
  .steps strong { display:block; font-weight:500; }
  .steps span { display:block; font-size:16px; color:var(--w80); margin-top:10px; }
  .button { display:inline-flex; justify-content:center; align-items:center; padding:20px 30px; background:var(--amber); color:var(--paper); border:1px solid var(--amber); font-size:12px; font-weight:500; line-height:1; letter-spacing:.05em; text-transform:uppercase; text-decoration:none; transition:background 250ms ease-out; }
  .button:hover { background:transparent; }
  .small { font-size:14px; line-height:1.75; margin-top:20px; }
  .prompt-column blockquote { font-size:16px; color:var(--w80); border-left:1px solid var(--amber); padding-left:20px; margin-top:20px; }
  .copy-button { margin-top:20px; }
  details { margin-top:var(--s30); padding-block:20px; border-top:1px solid var(--w15); border-bottom:1px solid var(--w15); }
  summary { cursor:pointer; font-size:16px; }
  #copy-status:empty { margin:0; }
  .measure { max-width:640px; }
  .destinations { margin-top:var(--s60); max-width:880px; }
  .destinations a { display:flex; justify-content:space-between; align-items:center; gap:20px; padding-block:var(--s30); border-top:1px solid var(--w15); text-decoration:none; }
  .destinations a:last-child { border-bottom:1px solid var(--w15); }
  .destinations a > span:first-child { font-size:24px; line-height:1.25; }
  .destinations a > span:last-child { font-size:14px; }
  .destinations a:hover > span:first-child { text-decoration:underline; text-underline-offset:5px; }
  footer { padding-block:var(--s40); color:var(--w60); font-size:14px; }
  .footer-inner { display:flex; flex-wrap:wrap; justify-content:space-between; gap:20px; }
  .presentation-controls { position:fixed; bottom:0; left:0; right:0; z-index:4; display:flex; justify-content:center; align-items:center; gap:30px; padding:14px var(--gutter); background:var(--ink); border-top:1px solid var(--w15); }
  #chapter-counter { font-size:14px; color:var(--w60); font-variant-numeric:tabular-nums; min-width:40px; text-align:center; }
  .presenting .site-header { position:sticky; top:0; z-index:4; background:var(--ink); }
  .presenting .chapter { min-height:calc(100svh - 80px); display:flex; align-items:center; padding-block:var(--s60) calc(var(--s60) + 80px); border-bottom:0; }
  .presenting footer { display:none; }
  @media (min-width:1100px) and (min-height:800px) { .presenting .chapter-grid { grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr); } }
  @media (max-width:900px) {
    .chapter-grid,.example-grid,.try-grid { grid-template-columns:1fr; gap:var(--s60); }
    .copy { max-width:640px; }
    figure { max-width:760px; }
    h1 br,h2 br { display:none; }
    .example-grid,.try-grid { margin-top:var(--s40); }
  }
  @media (max-width:540px) {
    .header-inner { min-height:80px; gap:12px; }
    .wordmark { font-size:14px; gap:8px; }
    #presentation-toggle { font-size:10px; padding:12px; max-width:145px; }
    .destinations a { align-items:flex-start; flex-direction:column; gap:10px; }
    .presentation-controls { gap:16px; }
    .presentation-controls .quiet-button { padding:14px 16px; }
  }
  @media (prefers-reduced-motion:reduce) { html { scroll-behavior:auto; } * { transition-duration:.01ms !important; } }
  @media print {
    body { background:#fff; color:#000; }
    .site-header,.presentation-controls,.copy-button,.button,.skip-link { display:none !important; }
    .chapter,.presenting .chapter { display:block !important; min-height:0; padding:30px 0; break-after:page; }
    .chapter[hidden] { display:block !important; }
    .muted,.eyebrow,.small,.copy > p,.measure,figcaption,.steps span,.prompt-column blockquote { color:#333 !important; }
    .chapter-grid,.example-grid,.try-grid { gap:30px; }
    details::details-content { display:block; content-visibility:visible; }
    figure { max-width:600px; margin-top:20px; }
    h1,h2 { font-size:36px; }
    footer { color:#333; }
  }
</style>
